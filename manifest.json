{
  "manifest_version": 3,
  "name": "SIMO Prep - Entrenador CNSC",
  "version": "1.0.0",
  "description": "Simulador de pruebas de juicio situacional para concursos de mérito de la CNSC / SIMO con metodologías de estudio activas.",
  "permissions": [
    "sidePanel",
    "storage",
    "alarms",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https:;"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Abrir SIMO Prep",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png",
      "192": "icons/icon192.png",
      "512": "icons/icon512.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "192": "icons/icon192.png",
    "512": "icons/icon512.png"
  }
}
